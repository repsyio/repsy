{
  "name": "repsy-os-frontend",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint-fix": "ng lint --fix",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\"",
    "gen:api": "openapi-generator-cli generate -i ../repsy-backend/src/main/resources/openapi/openapi-spec.yaml -g typescript-angular -o src/generated/api --additional-properties=fileNaming=kebab-case,ngVersion=21.0.0,withInterfaces=true",
    "vercel-build": "pnpm run build:prod"
  },
  "dependencies": {
    "@angular/animations": "^21.2.23",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-browser-dynamic": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "chart.js": "^4.5.1",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "jwt-decode": "^4.0.0",
    "md5": "^2.3.0",
    "moment": "^2.31.0",
    "ngx-highlightjs": "^14.0.1",
    "ngx-markdown": "^21.3.0",
    "postcss": "^8.5.28",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.2",
    "showdown": "^2.1.0",
    "showdown-highlight": "^3.1.0",
    "ts-md5": "^2.0.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@eslint/js": "^9.39.5",
    "@ngx-env/builder": "^21.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@types/jasmine": "~6.0.0",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.9.8",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.6.1",
    "daisyui": "^5.7.42",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
