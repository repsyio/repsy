# Panel API base URL (port 8080 in every topology). Falls back to http://localhost:8080.
REPSY_API_BASE_URL=http://localhost:8080

# Repository-operations base URL (port 9090 in every topology). Falls back to http://localhost:9090.
REPSY_REPO_BASE_URL=http://localhost:9090

# Admin credentials. The username falls back to "admin"; the password has no default and must be
# set to the same value as ADMIN_INITIAL_PASSWORD on the target instance.
REPSY_ADMIN_USERNAME=admin
REPSY_ADMIN_PASSWORD=

# local  = a stack this harness starts and owns (./run.sh local up), throttle limits can be tuned.
# remote = an already-running instance the harness does not own or reset; nothing global is touched.
# ci     = a pipeline-started stack, same freedoms as local.
REPSY_TARGET=local

# Which stack profile `./run.sh local up|down` starts/stops: unset (or anything other than "h2") is
# the postgres:18 profile (docker-compose.stack.yml); "h2" is the embedded-H2 profile
# (docker-compose.stack-h2.yml, no postgres service). Equivalent to passing --h2 on the command
# line; unused by "run.sh test", which is identical against either profile.
REPSY_E2E_STACK=

# Prefix for everything this run seeds (e2e-<runid>-...). Falls back to a random short id.
REPSY_E2E_RUN_ID=

# Set to a non-empty value when the target registry has to be reached over plain HTTP/an
# untrusted certificate: read by the docker runner's `--insecure` flag (crane already resolves
# localhost/loopback/RFC1918 hosts as plain HTTP on its own, so this is only needed for a remote
# plain-HTTP host); reserved for the future helm runner too. Unused by the skeleton.
REPSY_E2E_INSECURE_REGISTRY=

# --- UI suite (./run.sh test --protocol ui; README.md "UI suite") ---
# REPSY_ADMIN_PASSWORD must also satisfy the panel's LOGIN FORM (6-50 chars, a lower-case letter, an
# upper-case letter and a digit, no whitespace), or no UI test can log in; the ui project checks it
# before the first test and fails with a clear message.

# Base URL of the panel SPA. It is served on the API port, so this falls back to REPSY_API_BASE_URL,
# else http://localhost:8080 (NOT the protocol port 9090).
REPSY_UI_BASE_URL=

# Playwright workers in the ui runner. Falls back to 4; lower it on a small machine (each worker is
# a Chromium, ~250-400 MB) or when several stacks run at once.
REPSY_UI_WORKERS=

# Set to 1 to launch Chromium with its sandbox OFF (chromiumSandbox: false). Only for a kernel that
# forbids unprivileged user namespaces even with the shipped seccomp profile. Unset keeps it ON.
REPSY_UI_NO_SANDBOX=

# Comma list of opt-in UI suites that skip themselves otherwise, e.g. "throttle,scanner".
REPSY_UI_OPT_IN=
