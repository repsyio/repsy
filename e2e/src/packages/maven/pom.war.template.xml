<!--
  Rendered by clients/maven-reactor.ts next to a hand-written src/main/webapp/WEB-INF/web.xml
  (web.template.xml): a minimal `packaging=war` project, hand-built rather than generated by
  `mvn archetype:generate` so the bytes under test never depend on what an archetype scaffolds on a
  given day. Two shapes:
   - standalone (no `parentArtifactId`): its own groupId/version and its own distributionManagement;
   - the `web` module of the reactor (`parentArtifactId` set): everything but the artifactId comes from
     the parent, and it depends on the reactor's jar `libArtifactId`, so the war carries it in WEB-INF/lib.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  {{#parentArtifactId}}
  <parent>
    <groupId>{{groupId}}</groupId>
    <artifactId>{{parentArtifactId}}</artifactId>
    <version>{{version}}</version>
  </parent>

  <artifactId>{{artifactId}}</artifactId>
  {{/parentArtifactId}}
  {{^parentArtifactId}}
  <groupId>{{groupId}}</groupId>
  <artifactId>{{artifactId}}</artifactId>
  <version>{{version}}</version>
  {{/parentArtifactId}}
  <packaging>war</packaging>

  {{^parentArtifactId}}
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <distributionManagement>
    <repository>
      <id>repsy</id>
      <name>Repsy e2e repository</name>
      <url>{{repoUrl}}</url>
    </repository>
    <snapshotRepository>
      <id>repsy</id>
      <name>Repsy e2e repository</name>
      <url>{{repoUrl}}</url>
    </snapshotRepository>
  </distributionManagement>
  {{/parentArtifactId}}

  {{#libArtifactId}}
  <dependencies>
    <dependency>
      <groupId>{{groupId}}</groupId>
      <artifactId>{{libArtifactId}}</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  {{/libArtifactId}}

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <!-- The web.xml below is present; kept false so a webapp with none still builds. -->
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
