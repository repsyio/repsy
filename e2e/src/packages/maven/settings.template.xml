<!--
  Rendered by clients/maven.ts (mustache) into a per-test work directory, next to pom.xml. Server id
  "repsy" matches both the pom's distributionManagement/repository id and the "repsy::default::<url>"
  remoteRepositories argument clients/maven.ts gives dependency:get, so Maven applies these
  credentials to both a deploy and a resolve against the same repo. The "anonymous" credential
  (world.credential.transport is undefined) renders with no <server> at all, so the client sends no
  Authorization header rather than an empty/wrong one.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <servers>
    {{#hasCredential}}
    <server>
      <id>repsy</id>
      <username>{{username}}</username>
      <password>{{password}}</password>
    </server>
    {{/hasCredential}}
  </servers>
</settings>
