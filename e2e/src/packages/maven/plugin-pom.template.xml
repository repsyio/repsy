<!--
  Rendered by clients/maven-plugin.ts into a work directory next to src/main/java/.../HelloMojo.java:
  a one-goal Maven plugin (`hello:hi`, prefix taken from the artifactId `hello-maven-plugin` the way
  maven-plugin-plugin does; a second plugin of the group is `bye:hi`, and one that sets its own
  goalPrefix, which `plugin.xml` in the jar then names, is `tl:hi`, RPS-1458) that only logs a marker. The jar and this POM
  are what plugin-prefix.spec.ts then uploads by hand, the files Gradle, sbt or Ivy would send: no group-level maven-metadata.xml among them (RPS-1438).
  With `repoUrl` set (RPS-1488, maven-reactor-plugin.spec.ts) the POM also names the repository, so a real
  `mvn deploy` uploads the jar, the POM, the artifact-level and the group-level maven-metadata.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>{{groupId}}</groupId>
  <artifactId>{{artifactId}}</artifactId>
  <version>{{version}}</version>
  <packaging>maven-plugin</packaging>
  <name>{{name}}</name>

  {{#repoUrl}}
  <distributionManagement>
    <repository>
      <id>repsy</id>
      <name>Repsy e2e repository</name>
      <url>{{repoUrl}}</url>
    </repository>
  </distributionManagement>
  {{/repoUrl}}

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>3.9.9</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.13.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.13.1</version>
        {{#goalPrefix}}
        <configuration>
          <goalPrefix>{{goalPrefix}}</goalPrefix>
        </configuration>
        {{/goalPrefix}}
      </plugin>
    </plugins>
  </build>
</project>
