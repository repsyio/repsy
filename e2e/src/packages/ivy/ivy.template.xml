<!--
  Rendered by clients/ivy.ts (mustache) into a per-test work directory. The module a publish
  describes: a jar and a POM, which is what makes Repsy register the version (only a POM does), and
  optionally the dependencies the POM then lists.
-->
<ivy-module version="2.0">
  <info organisation="{{{groupId}}}" module="{{{module}}}" revision="{{{version}}}"/>
  <configurations>
    <conf name="default"/>
  </configurations>
  <publications>
    <artifact name="{{{module}}}" type="jar" ext="jar" conf="default"/>
    <artifact name="{{{module}}}" type="pom" ext="pom" conf="default"/>
  </publications>
  {{#hasDependencies}}
  <dependencies>
    {{#dependencies}}
    <dependency org="{{{groupId}}}" name="{{{artifactId}}}" rev="{{{version}}}" conf="default->default"/>
    {{/dependencies}}
  </dependencies>
  {{/hasDependencies}}
</ivy-module>
