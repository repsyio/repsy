{
  "description": "Test vectors of SuspiciousRequestClassifier (RPS-2319, RPS-2321), the probe ban of Repsy OS and Repsy Cloud. SuspiciousRequestVectorsTest runs every case against the classifier; repsy-cli vendors this file for its own port of the classifier (RPS-2633, RPS-2634), so a change of the classifier that is not reflected here fails the build. Every case lists the EXACT set of families the classifier reports on the API port (api) and on the protocol port (protocol), with the default settings: every family on, default weights, default port scope.",
  "format": {
    "method": "HTTP method; default GET.",
    "uri": "The request URI exactly as the server receives it: the raw path, then '?' and the raw query when there is one (getRequestURI() + '?' + getQueryString()). It is NOT decoded; a client that builds a request must compare its final, escaped URI with these.",
    "repeat": "Optional {text, times}: text repeated times is appended to uri (for the long URIs).",
    "suffix": "Optional text appended after repeat.",
    "userAgent": "The User-Agent header; default empty.",
    "browserNavigation": "Whether a browser navigates to the URL (Sec-Fetch-Mode: navigate, same origin); default false. A CLI never sends that.",
    "api": "Families on the API port (the port of the panel API), sorted by declaration order.",
    "protocol": "Families on the protocol port (the package format routes)."
  },
  "overlongUriLength": 2048,
  "maxInspectedLength": 4096,
  "families": [
    {"name": "TRAVERSAL", "key": "traversal", "weight": 5, "apiPortOnly": false, "bansAlone": true},
    {"name": "SECRET_PATH", "key": "secret-path", "weight": 5, "apiPortOnly": true, "bansAlone": true},
    {"name": "NULL_BYTE", "key": "null-byte", "weight": 3, "apiPortOnly": false, "bansAlone": true},
    {"name": "METHOD_ABUSE", "key": "method-abuse", "weight": 3, "apiPortOnly": true, "bansAlone": true},
    {"name": "SCRIPT_TARGET", "key": "script-target", "weight": 3, "apiPortOnly": true, "bansAlone": true},
    {"name": "SQLI", "key": "sqli", "weight": 2, "apiPortOnly": true, "bansAlone": true},
    {"name": "XSS", "key": "xss", "weight": 2, "apiPortOnly": true, "bansAlone": true},
    {"name": "CMDI", "key": "cmdi", "weight": 2, "apiPortOnly": true, "bansAlone": true},
    {"name": "SSRF_URL", "key": "ssrf-url", "weight": 3, "apiPortOnly": true, "bansAlone": true},
    {"name": "LOG4SHELL", "key": "log4shell", "weight": 5, "apiPortOnly": false, "bansAlone": true},
    {"name": "SSTI", "key": "ssti", "weight": 2, "apiPortOnly": true, "bansAlone": true},
    {"name": "DOUBLE_ENCODED", "key": "double-encoded", "weight": 1, "apiPortOnly": true, "bansAlone": true},
    {"name": "OVERLONG_URI", "key": "overlong-uri", "weight": 1, "apiPortOnly": true, "bansAlone": true},
    {"name": "SCANNER_UA", "key": "scanner-ua", "weight": 3, "apiPortOnly": false, "bansAlone": false}
  ],
  "cases": [
    {"name": "traversal to /proc/self", "uri": "/api/orders/../../proc/self/environ", "api": ["TRAVERSAL", "SECRET_PATH"], "protocol": ["TRAVERSAL"]},
    {"name": "traversal to .env", "uri": "/api/data/../../.env", "api": ["TRAVERSAL", "SECRET_PATH"], "protocol": ["TRAVERSAL"]},
    {"name": "encoded dot-dot to /etc/passwd", "uri": "/api/%2e%2e/%2e%2e/etc/passwd", "api": ["TRAVERSAL", "SECRET_PATH"], "protocol": ["TRAVERSAL"]},
    {"name": "upper-case encoded dot-dot", "uri": "/api/%2E%2E/secret", "api": ["TRAVERSAL"], "protocol": ["TRAVERSAL"]},
