<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.repsy.core</groupId>
    <artifactId>core</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>core/pom.xml</relativePath>
  </parent>

  <groupId>io.repsy.os</groupId>
  <artifactId>repsy-os</artifactId>
  <packaging>pom</packaging>
  <url>https://github.com/repsyio/repsy-os</url>

  <scm>
    <connection>scm:git:https://github.com/repsyio/repsy-os-tmp.git</connection>
    <developerConnection>scm:git:https://github.com/repsyio/repsy-os-tmp.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!--
      TEMPORARY: core-parent enforces an 80% JaCoCo instruction-coverage gate (check-coverage
      execution), intended for repsy-core's own modules. Every repsy module inherits it through
      core/pom.xml, so it is off by default here and opted into per module (set this property to
      "verify") once a module meets the threshold. Coverage reports are still generated for
      SonarCloud. Remove this override once every module has opted in.
    -->
    <jacoco.check.phase>none</jacoco.check.phase>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.repsy.core</groupId>
        <artifactId>core-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>repsy-backend</module>
    <module>libs</module>
    <module>repsy-protocols</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <phase>${jacoco.check.phase}</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Integration tests (*IT.java, e.g. Testcontainers-backed) run here, not in Surefire, so
        "mvn test" stays fast and Docker-free; "mvn verify" runs both. Same argLine as Surefire in
        core-parent, so the JaCoCo agent (and thus the coverage report) covers them too.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>${argLine} -Duser.timezone=UTC</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
