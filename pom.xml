<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.repsy.core</groupId>
    <artifactId>core</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>core/pom.xml</relativePath>
  </parent>

  <groupId>io.repsy.os</groupId>
  <artifactId>repsy-os</artifactId>
  <packaging>pom</packaging>
  <url>https://github.com/repsyio/repsy-os</url>

  <scm>
    <connection>scm:git:https://github.com/repsyio/repsy-os-tmp.git</connection>
    <developerConnection>scm:git:https://github.com/repsyio/repsy-os-tmp.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!--
      TEMPORARY: core-parent enforces an 80% JaCoCo instruction-coverage gate (check-coverage
      execution), intended for repsy-core's own modules. Every repsy module inherits it through
      core/pom.xml, so it is off by default here and opted into per module (set this property to
      "verify") once a module meets the threshold. Coverage reports are still generated for
      SonarCloud. Remove this override once every module has opted in.
    -->
    <jacoco.check.phase>none</jacoco.check.phase>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.repsy.core</groupId>
        <artifactId>core-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>repsy-backend</module>
    <module>libs</module>
    <module>repsy-protocols</module>
    <module>repsy-frontend</module>
  </modules>

  <build>
    <plugins>
      <!--
        RPS-964: promote the Error Prone checks this repo has cleaned to errors so they stay at zero.
        Error Prone reads its flags only from the -Xplugin argument, so this restates core-parent's
        compilerArgs (keep the other args in sync with it) with the extra -Xep:<Check>:ERROR flags.
      -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.self="override">
            <arg>-parameters</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-Xplugin:ErrorProne -Xep:UnicodeInCode:OFF -Xep:MissingOverride:ERROR -Xep:StringCaseLocaleUsage:ERROR -Xep:InlineFormatString:ERROR -Xep:StringSplitter:ERROR -Xep:BadImport:ERROR -Xep:EmptyCatch:ERROR -Xep:UnusedMethod:ERROR -Xep:DefaultCharset:ERROR -Xep:EnumOrdinal:ERROR -Xep:TypeParameterUnusedInFormals:ERROR -Xep:NonApiType:ERROR -Xep:PatternMatchingInstanceof:ERROR -Xep:LoopOverCharArray:ERROR -Xep:ReferenceEquality:ERROR -XepExcludedPaths:(.*/src/test/.*|.*/target/.*)</arg>
            <arg>--should-stop=ifError=FLOW</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
        e2e/ is outside the Maven reactor (not in <modules>) but still under this pom's basedir, so
        core-parent's RAT execution (bound to the "verify" phase) still scans it. Its own dotfiles
        (.dockerignore, .env.example, .prettierignore) have no counterpart in core-parent's default
        excludes, and node_modules/, src/api/generated/, test-results/ and playwright-report/ are
        generated or third-party content (all git-ignored, see e2e/.gitignore) that was never meant
        to carry a licence header. src/packages/ holds the template projects the adapters render and
        publish (Cargo.toml, go.mod, Gemfile, ...): their content is what the client under test
        sees, so it stays free of a header. Everything else under e2e/ (*.ts, Dockerfiles, run.sh, ...) is a
        source file and does carry one. combine.children="append" adds these to core-parent's list
        instead of replacing it, which is what a same-named <excludes> block does by default.
      -->
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <excludes combine.children="append">
            <exclude>e2e/.dockerignore</exclude>
            <exclude>e2e/.env.example</exclude>
            <exclude>e2e/.prettierignore</exclude>
            <exclude>e2e/node_modules/**</exclude>
            <exclude>e2e/src/api/generated/**</exclude>
            <exclude>e2e/src/packages/**</exclude>
            <exclude>e2e/test-results/**</exclude>
            <exclude>e2e/playwright-report/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <phase>${jacoco.check.phase}</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Integration tests (*IT.java, e.g. Testcontainers-backed) run here, not in Surefire, so
        "mvn test" stays fast and Docker-free; "mvn verify" runs both. Same argLine as Surefire in
        core-parent, so the JaCoCo agent (and thus the coverage report) covers them too.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <argLine>${argLine} -Duser.timezone=UTC</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
